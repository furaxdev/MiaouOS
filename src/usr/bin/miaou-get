#!/bin/sh
. /usr/lib/miaou/package-engine.sh
command_name=${1:-help}
case "$command_name" in
  list)
    miaou_list
    ;;
  install)
    [ "$#" -eq 2 ] || { echo "Usage: miaou-get install fichier.miaou" >&2; exit 2; }
    miaou_install "$2"
    ;;
  remove|uninstall)
    [ "$#" -eq 2 ] || { echo "Usage: miaou-get remove nom" >&2; exit 2; }
    miaou_remove "$2"
    ;;
  search)
    [ "$#" -ge 2 ] || { echo "Usage: miaou-get search texte" >&2; exit 2; }
    shift
    miaou_search "$*"
    ;;
  help|--help|-h)
    miaou_help
    ;;
  *)
    echo "Commande inconnue: $command_name" >&2
    miaou_help >&2
    exit 2
    ;;
esac
