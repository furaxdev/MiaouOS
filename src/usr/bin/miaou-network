#!/bin/sh
while :; do
 printf '\033[2J\033[H'
 echo "  Miaou Network — Réseau"
 echo
 echo "  Interfaces :"
 ip -brief address 2>/dev/null || ifconfig 2>/dev/null || echo "Aucun outil réseau disponible."
 echo
 echo "  Routes :"
 ip route 2>/dev/null || route -n 2>/dev/null || true
 echo
 echo "  [1] Tester une adresse (ping)  [2] Actualiser  [0] Quitter"
 printf '  Choix : '
 IFS= read -r c || exit 0
 case "$c" in
  1) printf '  Hôte à tester : '; IFS= read -r host; case "$host" in ''|*[!A-Za-z0-9.:-]*) echo "Nom d'hôte invalide."; sleep 1;; *) ping -c 3 -W 2 "$host"; printf '\nEntrée...'; IFS= read -r pause;; esac ;;
  0) exit 0 ;;
 esac
done
